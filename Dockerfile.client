# MultiRegistrator client image.
#
# The client is a Qt desktop application, so the container runs a virtual X
# server (Xvfb) with a lightweight window manager and exposes it through noVNC
# — open http://localhost:6080/vnc.html in a browser.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DISPLAY=:99 \
    SCREEN_GEOMETRY=1600x1000x24 \
    MULTIREGISTRATOR_SERVER=server:8120

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        xvfb x11-utils fluxbox x11vnc novnc websockify tini \
        libgl1 libegl1 libxkbcommon0 libxkbcommon-x11-0 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-cursor0 \
        libdbus-1-3 libfontconfig1 libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-client.txt ./
RUN pip install --no-cache-dir -r requirements-client.txt

COPY multiregistrator ./multiregistrator
COPY packaging ./packaging
COPY deploy/entrypoint-client.sh /usr/local/bin/entrypoint-client.sh
# Empty fluxbox startup so it does not spawn the "no wallpaper setter" dialog.
RUN chmod +x /usr/local/bin/entrypoint-client.sh \
    && mkdir -p /app/config /app/logs /root/.fluxbox \
    && printf '#!/bin/sh\n' > /root/.fluxbox/startup \
    && chmod +x /root/.fluxbox/startup

EXPOSE 6080

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-client.sh"]
